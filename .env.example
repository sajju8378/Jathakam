# JyotishVeda Configuration Environment Variables

# --- Server Ports & URLs ---
PORT=3000
API_PORT=8001
APP_URL="http://localhost:3000"

# --- Database & Caching ---
# PostgreSQL connection string for user charts
DATABASE_URL="postgresql://jyotish_user:jyotish_password@localhost:5432/jyotish_db"

# Redis connection string for 24h Panchang caching and Geocoding results
# (If Redis is not available, the application automatically falls back to high-performance in-memory caching)
REDIS_URL="redis://localhost:6379/0"

# --- Third-Party Panchang Provider (Prokerala Astrology API v2) ---
# Register at https://www.prokerala.com/astrology/api/ to get client credentials
# (If left empty, the engine automatically uses local Swiss Ephemeris calculations)
PROKERALA_CLIENT_ID=""
PROKERALA_CLIENT_SECRET=""

# --- Geocoding ---
# OpenStreetMap Nominatim Contact User-Agent header (required by OSM usage policy)
GEOCODING_USER_AGENT="JyotishVeda-App/1.0 (astro-contact@jyotishveda.internal)"

# --- Security & Cryptography ---
SECRET_KEY="jyotish-veda-super-secret-key-change-in-production"
